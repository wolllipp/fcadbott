generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHAIRMAN
  DEAN
  DEPUTY
  SECRETARY
  COORDINATOR
}

enum BudgetStatus {
  BUDGET
  PAID
  NO_STIPEND
}

enum BonusStatus {
  PENDING
  APPROVED
  DEFERRED
}

enum ExemptionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Coordinator {
  id               Int     @id @default(autoincrement())
  fullName         String
  telegramUsername String  @unique
  role             Role
  sector           String?
  chatId           String?

  exemptions       Exemption[]
  bonusSubmissions BonusSubmission[]

  createdAt DateTime @default(now())
}

model Student {
  id                Int          @id @default(autoincrement())
  fullName          String
  birthDate         DateTime?
  groupNumber       String
  studentCardNumber String
  sectors           String[]
  budgetStatus      BudgetStatus @default(BUDGET)

  exemptionStudents ExemptionStudent[]
  bonusEntries      BonusEntry[]
}

model Exemption {
  id            Int             @id @default(autoincrement())
  exemptionDate DateTime
  reason        String
  createdBy     Int
  coordinator   Coordinator     @relation(fields: [createdBy], references: [id])
  status        ExemptionStatus @default(PENDING)
  createdAt     DateTime        @default(now())

  students ExemptionStudent[]
}

model ExemptionStudent {
  id          Int       @id @default(autoincrement())
  exemptionId Int
  exemption   Exemption @relation(fields: [exemptionId], references: [id])
  studentId   Int?
  student     Student?  @relation(fields: [studentId], references: [id])

  externalName       String?
  externalGroup      String?
  externalCardNumber String?
}

model BonusSubmission {
  id            Int         @id @default(autoincrement())
  month         Int
  year          Int
  coordinatorId Int
  coordinator   Coordinator @relation(fields: [coordinatorId], references: [id])
  status        BonusStatus @default(PENDING)
  submittedAt   DateTime    @default(now())

  entries BonusEntry[]

  @@unique([month, year, coordinatorId])
}

model BonusEntry {
  id           Int             @id @default(autoincrement())
  submissionId Int
  submission   BonusSubmission @relation(fields: [submissionId], references: [id])
  studentId    Int?
  student      Student?        @relation(fields: [studentId], references: [id])

  externalName       String?
  externalGroup      String?
  externalCardNumber String?

  amount             Decimal @db.Decimal(10, 2)
  reason             String  @default("Организация мероприятий на факультете и в университете и участие в них")
  deferredToMonth    Int?
  deferredToYear     Int?
  budgetStudentName  String? // For paid students: the budget student whose line they go under
  budgetStudentGroup String?
  budgetStudentCard  String?
}
