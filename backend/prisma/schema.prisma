generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHAIRMAN
  DEAN
  DEPUTY
  SECRETARY
  COORDINATOR
}

enum BudgetStatus {
  BUDGET
  PAID
  NO_STIPEND
}

enum BonusStatus {
  PENDING
  APPROVED
  DEFERRED
}

enum ExemptionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Coordinator {
  id               Int      @id @default(autoincrement())
  fullName         String
  telegramUsername String   @unique
  role             Role
  sector           String?
  chatId           String?

  managedSector    Sector?
  exemptions       Exemption[]
  events           Event[]
  bonusSubmissions BonusSubmission[]

  createdAt DateTime @default(now())
}

model Sector {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  coordinatorId  Int          @unique
  coordinator    Coordinator  @relation(fields: [coordinatorId], references: [id])

  members        SectorMember[]

  createdAt DateTime @default(now())
}

model SectorMember {
  id        Int    @id @default(autoincrement())
  sectorId  Int
  sector    Sector @relation(fields: [sectorId], references: [id])

  fullName          String
  groupNumber       String
  studentCardNumber String

  @@unique([sectorId, fullName, groupNumber])
}

model Student {
  id                Int          @id @default(autoincrement())
  fullName          String
  birthDate         DateTime?
  groupNumber       String
  studentCardNumber String
  telegramUsername  String?      @unique
  chatId            String?
  sectors           String[]
  budgetStatus      BudgetStatus @default(BUDGET)

  exemptionStudents ExemptionStudent[]
  bonusEntries      BonusEntry[]
  petitions         Petition[]
}

model Exemption {
  id             Int             @id @default(autoincrement())
  exemptionDate  DateTime
  reason         String
  createdBy      Int
  coordinator    Coordinator     @relation(fields: [createdBy], references: [id])
  status         ExemptionStatus @default(PENDING)
  isExhibited    Boolean         @default(false)
  editedAt       DateTime?
  createdAt      DateTime        @default(now())

  students ExemptionStudent[]
}

model ExemptionStudent {
  id          Int       @id @default(autoincrement())
  exemptionId Int
  exemption   Exemption @relation(fields: [exemptionId], references: [id])
  studentId   Int?
  student     Student?  @relation(fields: [studentId], references: [id])

  externalName        String?
  externalGroup       String?
  externalCardNumber  String?
}

model Event {
  id          Int    @id @default(autoincrement())
  name        String
  eventDate   DateTime
  description String?
  createdBy   Int
  attendanceFinalized Boolean @default(false)

  creator      Coordinator        @relation(fields: [createdBy], references: [id])
  participants EventParticipant[]

  createdAt DateTime @default(now())
}

model EventParticipant {
  id          Int   @id @default(autoincrement())
  eventId     Int
  event       Event @relation(fields: [eventId], references: [id])

  fullName    String
  groupNumber String
  attended    Boolean @default(false)
}

model BonusSubmission {
  id            Int         @id @default(autoincrement())
  month         Int
  year          Int
  coordinatorId Int
  coordinator   Coordinator @relation(fields: [coordinatorId], references: [id])
  status        BonusStatus @default(PENDING)
  submittedAt   DateTime    @default(now())

  entries BonusEntry[]

  @@unique([month, year, coordinatorId])
}

model BonusEntry {
  id           Int             @id @default(autoincrement())
  submissionId Int
  submission   BonusSubmission @relation(fields: [submissionId], references: [id])
  studentId    Int?
  student      Student?        @relation(fields: [studentId], references: [id])

  externalName        String?
  externalGroup       String?
  externalCardNumber  String?

  amount            Decimal  @db.Decimal(10, 2)
  reason            String   @default("Организация мероприятий на факультете и в университете и участие в них")
  deferredToMonth   Int?
  deferredToYear    Int?
  budgetStudentName String?  // For paid students: the budget student whose line they go under
  budgetStudentGroup String?
  budgetStudentCard String?
}

enum PetitionType {
  DISCOUNT
  DORMITORY
  SPECIALIZATION
}

enum PetitionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Petition {
  id         Int             @id @default(autoincrement())
  studentId  Int
  student    Student         @relation(fields: [studentId], references: [id])
  type       PetitionType
  status     PetitionStatus  @default(PENDING)
  createdAt  DateTime        @default(now())
  approvedAt DateTime?

  events PetitionEvent[]
}

model PetitionEvent {
  id         Int      @id @default(autoincrement())
  petitionId Int
  petition   Petition @relation(fields: [petitionId], references: [id])

  eventId   Int
  eventName String
  eventDate DateTime
}
