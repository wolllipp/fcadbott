generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHAIRMAN
  DEAN
  DEPUTY
  SECRETARY
  COORDINATOR
}

enum BudgetStatus {
  BUDGET
  PAID
  NO_STIPEND
}

enum BonusStatus {
  PENDING
  APPROVED
  DEFERRED
}

enum ExemptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
}

enum EventAudience {
  SS
  FKP
  ALL
}

enum ParticipationType {
  VISITOR
  PARTICIPANT
  ORGANIZER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  AWAITING_MARK
  ATTENDANCE_CONFIRMED
}

enum PointType {
  ATTENDANCE
  ORGANIZATION
  MANUAL_ADJUSTMENT
}

enum PointStatus {
  ACTIVE
  CANCELLED
}

enum CheckType {
  CHECK_IN
  CHECK_OUT
}

model Coordinator {
  id               Int      @id @default(autoincrement())
  fullName         String
  telegramUsername String   @unique
  role             Role
  sector           String?
  chatId           String?
  photoUrl         String?

  managedSector    Sector?
  exemptions       Exemption[]
  events           Event[]   @relation("EventCreator")
  scannedEvents    Event[]   @relation("ScannerCoordinator")
  bonusSubmissions BonusSubmission[]
  pointTransactions PointTransaction[]
  approvedApplications EventApplication[]
  reviewedPetitions Petition[]

  createdAt DateTime @default(now())
}

model Sector {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  coordinatorId  Int          @unique
  coordinator    Coordinator  @relation(fields: [coordinatorId], references: [id])

  members        SectorMember[]

  createdAt DateTime @default(now())
}

model SectorMember {
  id        Int    @id @default(autoincrement())
  sectorId  Int
  sector    Sector @relation(fields: [sectorId], references: [id])

  fullName          String
  groupNumber       String
  studentCardNumber String

  @@unique([sectorId, fullName, groupNumber])
}

model Student {
  id                Int          @id @default(autoincrement())
  fullName          String
  birthDate         DateTime?
  groupNumber       String
  studentCardNumber String
  telegramUsername  String?      @unique
  chatId            String?
  sectors           String[]
  budgetStatus      BudgetStatus @default(BUDGET)
  photoUrl          String?

  exemptionStudents  ExemptionStudent[]
  bonusEntries       BonusEntry[]
  petitions          Petition[]
  eventApplications  EventApplication[]
  pointTransactions  PointTransaction[]
}

model Exemption {
  id             Int             @id @default(autoincrement())
  exemptionDate  DateTime
  reason         String
  createdBy      Int
  coordinator    Coordinator     @relation(fields: [createdBy], references: [id])
  status         ExemptionStatus @default(PENDING)
  isExhibited    Boolean         @default(false)
  isPrinted    Boolean         @default(false)
  editedAt       DateTime?
  createdAt      DateTime        @default(now())

  students ExemptionStudent[]
}

model ExemptionStudent {
  id          Int       @id @default(autoincrement())
  exemptionId Int
  exemption   Exemption @relation(fields: [exemptionId], references: [id])
  studentId   Int?
  student     Student?  @relation(fields: [studentId], references: [id])

  externalName        String?
  externalGroup       String?
  externalCardNumber  String?
}

model Event {
  id          Int    @id @default(autoincrement())
  name        String
  eventDate   DateTime
  description String?
  createdBy   Int
  scannerCoordinatorId Int?
  attendanceFinalized Boolean @default(false)

  creator      Coordinator        @relation("EventCreator", fields: [createdBy], references: [id])
  scannerCoordinator Coordinator? @relation("ScannerCoordinator", fields: [scannerCoordinatorId], references: [id])
  participants EventParticipant[]

  createdAt DateTime @default(now())

  location           String?
  endDate            DateTime?
  registrationDeadline DateTime?
  pointsForAttendance Int     @default(0)
  maxParticipants    Int?
  status             EventStatus @default(DRAFT)
  audience           EventAudience @default(ALL)
  allowedGroups      String[]
  facultyOnly        Boolean @default(false)
  requireApproval    Boolean @default(false)

  applications       EventApplication[]
  pointTransactions  PointTransaction[]
}

model EventParticipant {
  id          Int   @id @default(autoincrement())
  eventId     Int
  event       Event @relation(fields: [eventId], references: [id])

  fullName    String
  groupNumber String
  attended    Boolean @default(false)
}

model EventApplication {
  id                Int      @id @default(autoincrement())
  eventId           Int
  event             Event    @relation(fields: [eventId], references: [id])
  studentId         Int
  student           Student  @relation(fields: [studentId], references: [id])

  participationType ParticipationType @default(VISITOR)
  status            ApplicationStatus @default(PENDING)

  studentComment    String?
  coordinatorComment String?

  approvedById      Int?
  approver          Coordinator? @relation(fields: [approvedById], references: [id])
  approvedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())

  qrToken           String?   @unique
  checkedIn         Boolean   @default(false)
  checkedOut        Boolean   @default(false)
  checkInTime       DateTime?
  checkOutTime      DateTime?
  checkedInById     Int?
  checkedOutById    Int?

  attendances       Attendance[]

  @@unique([eventId, studentId])
}

model Attendance {
  id              Int      @id @default(autoincrement())
  applicationId   Int
  application     EventApplication @relation(fields: [applicationId], references: [id])

  type            CheckType
  scannedById     Int?
  scannedAt       DateTime @default(now())

  createdAt       DateTime @default(now())
}

model PointTransaction {
  id          Int       @id @default(autoincrement())
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id])

  points      Int
  type        PointType
  eventId     Int?
  event       Event?    @relation(fields: [eventId], references: [id])
  reason      String

  authorId    Int?
  author      Coordinator? @relation(fields: [authorId], references: [id])

  status      PointStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
}

model BonusSubmission {
  id            Int         @id @default(autoincrement())
  month         Int
  year          Int
  coordinatorId Int
  coordinator   Coordinator @relation(fields: [coordinatorId], references: [id])
  status        BonusStatus @default(PENDING)
  submittedAt   DateTime    @default(now())

  entries BonusEntry[]

  @@unique([month, year, coordinatorId])
}

model BonusEntry {
  id           Int             @id @default(autoincrement())
  submissionId Int
  submission   BonusSubmission @relation(fields: [submissionId], references: [id])
  studentId    Int?
  student      Student?        @relation(fields: [studentId], references: [id])

  externalName        String?
  externalGroup       String?
  externalCardNumber  String?

  amount            Decimal  @db.Decimal(10, 2)
  reason            String   @default("Организация мероприятий на факультете и в университете и участие в них")
  deferredToMonth   Int?
  deferredToYear    Int?
  budgetStudentName String?
  budgetStudentGroup String?
  budgetStudentCard String?
}

enum PetitionType {
  DISCOUNT
  DORMITORY
  SPECIALIZATION
}

enum PetitionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model Petition {
  id         Int             @id @default(autoincrement())
  studentId  Int
  student    Student         @relation(fields: [studentId], references: [id])
  type       PetitionType
  status     PetitionStatus  @default(PENDING)
  createdAt  DateTime        @default(now())
  approvedAt DateTime?

  events PetitionEvent[]

  balanceAtSubmit   Int     @default(0)
  totalPoints       Int     @default(0)
  reviewComment     String?
  reviewerId        Int?
  reviewer          Coordinator? @relation(fields: [reviewerId], references: [id])

  snapshots PetitionPointSnapshot[]
}

model PetitionEvent {
  id         Int      @id @default(autoincrement())
  petitionId Int
  petition   Petition @relation(fields: [petitionId], references: [id])

  eventId   Int
  eventName String
  eventDate DateTime
}

model PetitionPointSnapshot {
  id         Int      @id @default(autoincrement())
  petitionId Int
  petition   Petition @relation(fields: [petitionId], references: [id])

  points     Int
  type       String
  reason     String
  eventName  String?
  createdAt  DateTime
}
